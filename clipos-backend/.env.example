NVIDIA_API_KEY=
OPENROUTER_API_KEY=
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///./clipos.db
# Executable paths. Auto-discovery prefers Homebrew's stable ffmpeg-full opt path.
# FFMPEG_FULL_PATH remains supported as either an ffmpeg executable or bin directory.
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_TIMEOUT_SECONDS=900
ANALYSIS_TIMEOUT_SECONDS=1800
# Optional local-library root; imports are resolved inside this folder (including symlinks).
# MEDIA_ROOT=/path/to/recordings
CHUNK_SECONDS=300
CHUNK_OVERLAP_SECONDS=15
ASR_MODEL=base
ASR_VAD=true
ANALYSIS_MAX_CHARS=24000
TARGET_CLIP_COUNT=10
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
CANDIDATE_TOTAL_SECONDS=600
# Initial navigation sample; final clips always read the full original.
NAVIGATION_SECONDS=60
CACHE_MAX_GB=20
MAX_SOURCE_GB=100
DOWNLOAD_TIMEOUT_SECONDS=1800
# Ordered provider:model tiers. JSON arrays are required for list settings.
TEXT_MODELS=["nvidia:z-ai/glm-5.2","nvidia:mistralai/mistral-nemotron","openrouter:z-ai/glm-5.2:free"]
# Add an image-capable OpenRouter model ID before enabling vision.
VISION_MODELS=[]
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_DEADLINE_SECONDS=240
LLM_RETRIES=1
LLM_BACKOFF_SECONDS=1
# Experimental signals remain opt-in pending comparison on marked real recordings.
SELECTION_AUDIO_ENABLED=false
SELECTION_SCENE_ENABLED=false
SELECTION_VISION_ENABLED=false
SELECTION_SHORTLIST_COUNT=20
SELECTION_CANDIDATES_PER_CHUNK=12
SELECTION_SETUP_SECONDS=12
SELECTION_PAYOFF_SECONDS=18
SELECTION_AUDIO_PEAK_RATIO=3
SELECTION_SCENE_THRESHOLD=0.25
SELECTION_MIN_SCORE=0.45
VISION_FRAMES=6
